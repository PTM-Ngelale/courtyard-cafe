# Copy to .env.local and fill in. Never commit real values.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack > Settings > API Keys & Webhooks (sk_test_... while testing)
PAYSTACK_SECRET_KEY=

# Optional: the public site URL Paystack returns customers to.
# Defaults to the URL the request came in on.
SITE_URL=
